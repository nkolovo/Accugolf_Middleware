<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net48       → production build (Spinnaker SDK, workstation only)
      net10.0-windows → dev/test build (no Spinnaker, runs on any Windows machine)
    -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <AssemblyName>SportSimulator</AssemblyName>
    <RootNamespace>SportSimulator</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Spinnaker SDK ships only 64-bit binaries — x86/AnyCPU will fail at runtime.
    -->
  </PropertyGroup>

  <!-- ── Spinnaker Managed SDK — net48 only ────────────────────────────────
       Confirmed installed at (SDK 4.2.0.83, Teledyne-branded installer):
         C:\Program Files\Teledyne\Spinnaker\bin64\vs2015\

       This install ships ONE managed assembly — SpinnakerNET_v140.dll —
       whose assembly name is "SpinnakerNET_v140" (not "SpinnakerNET").
       It contains BOTH the SpinnakerNET and SpinnakerNET.GenApi namespaces,
       so a single <Reference> covers both `using` statements in the code
       (older SDKs shipped these as two separate DLLs — this one doesn't).

       If your workstation installed to a different path, set the
       SpinnakerSDKDir MSBuild property (must end in a trailing backslash)
       instead of editing this HintPath.
  ─────────────────────────────────────────────────────────────────────────-->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="SpinnakerNET_v140">
      <HintPath Condition="'$(SpinnakerSDKDir)' != ''">$(SpinnakerSDKDir)SpinnakerNET_v140.dll</HintPath>
      <HintPath Condition="'$(SpinnakerSDKDir)' == ''">C:\Program Files\Teledyne\Spinnaker\bin64\vs2015\SpinnakerNET_v140.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- ── Exclude Tests/ subfolder from main project glob ─────────────────
       SDK-style projects glob **/*.cs from the project root, which would
       pull in the test files and their xUnit/FluentAssertions references.
  ─────────────────────────────────────────────────────────────────────────-->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <!-- ── CameraManager uses SpinnakerNET — exclude from non-net48 builds ───
       MockCameraManager and ICameraManager are always compiled.
  ─────────────────────────────────────────────────────────────────────────-->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="Vision\CameraManager.cs" />
  </ItemGroup>

  <!-- ── Emgu.CV (OpenCV wrapper — available on NuGet) ─────────────────────
       Emgu.CV.runtime.windows bundles the native OpenCV DLLs for Windows x64.
  ─────────────────────────────────────────────────────────────────────────-->
  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.9.0.5494" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.9.0.5494" />
  </ItemGroup>

  <!-- ── JSON (used by PacketSerializer and SportProfileRegistry) ──────────-->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Pin System.Text.Json to a patched version to clear the NU1903 warnings -->
    <PackageReference Include="System.Text.Json" Version="9.0.5" />
  </ItemGroup>

</Project>
